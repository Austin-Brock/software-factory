# Copy to .env and fill in values. .env is gitignored.
AWS_PROFILE=software-factory
AWS_REGION=us-east-1
# A Bedrock model (or cross-region inference profile) your account can invoke, e.g.
# openai.gpt-oss-120b-1:0 (list: aws bedrock list-foundation-models)
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
# Optional cost caps
# PLANNER_MAX_TOKENS=4096
# PLANNER_MAX_TICKET_CHARS=20000
# Budget kill-switch alert recipient (used by infrastructure/)
BUDGET_ALERT_EMAIL=
