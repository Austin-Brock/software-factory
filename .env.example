# Copy to .env and fill in values. .env is gitignored.
AWS_PROFILE=software-factory
AWS_REGION=us-east-1
# A Bedrock model (or cross-region inference profile) your account can invoke, e.g.
# us.anthropic.claude-sonnet-5-5 (list: aws bedrock list-inference-profiles)
BEDROCK_MODEL_ID=
# Optional cost caps
# PLANNER_MAX_TOKENS=4096
# PLANNER_MAX_TICKET_CHARS=20000
